NODE_ENV=
PORT=

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

EMAIL_PROVIDER=elastic_email
ELASTIC_EMAIL_API_KEY=
ELASTIC_EMAIL_FROM_EMAIL=
ELASTIC_EMAIL_FROM_NAME=Buybox

# SMTP Configuration (Standard SMTP: Gmail App Password, Mailtrap, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Buybox
SMTP_REPLY_TO=

# Google OAuth 2.0 / OIDC Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Web Client, CORS & Ingress Configuration
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# TRUST_PROXY: Set to false for direct local dev, 1 for single proxy (ALB/Cloudflare), or subnets
TRUST_PROXY=false

# Redis Cache & Background Queue Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

PAYMENT_RECONCILIATION_SCAN_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_BATCH_SIZE=50

# Persistent Media Storage Configuration (local or s3)
MEDIA_STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false


# ----------------------------------------------------
# Shipping, Couriers & Webhook Integration
# ----------------------------------------------------
# Delhivery Courier Integration
# DELHIVERY_API_KEY: Production or Sandbox API token (used in Authorization header: Token <key>)
# Leave empty to operate in non-configured fallback mode (no synthetic AWBs)
# DELHIVERY_CLIENT_ID: Registered Delhivery Client ID / Account Name
# DELHIVERY_CLIENT_SECRET: Webhook signing secret used to verify X-Delhivery-Signature (HMAC-SHA256)
# DELHIVERY_WEBHOOK_SECRET: Optional alias for DELHIVERY_CLIENT_SECRET for webhook verification
DELHIVERY_API_KEY=
DELHIVERY_CLIENT_ID=
DELHIVERY_CLIENT_SECRET=
DELHIVERY_WEBHOOK_SECRET=

# Shiprocket Logistics Aggregator
# SHIPROCKET_EMAIL: Registered Shiprocket account email address (used for Bearer JWT auth)
# SHIPROCKET_PASSWORD: Registered Shiprocket account password (used for Bearer JWT auth)
# SHIPROCKET_API_KEY: Optional Shiprocket API key / webhook token
# SHIPROCKET_WEBHOOK_SECRET: Webhook verification secret checked against X-Api-Key / X-Webhook-Token header
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_API_KEY=
SHIPROCKET_WEBHOOK_SECRET=
