# ==========================================
# Buybox E-Commerce — Root .gitignore
# ==========================================

# Database & Runtime Data
.mongodb_data/
*.wt
WiredTiger*
mongod.lock

# Environment & Secrets (Preserve templates)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Frontend Build Outputs
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
frontend/coverage/
backend/coverage/
.nyc_output/
.jest/

# Logs & Debugging
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python & Virtual Environments (if any utility scripts used)
__pycache__/
*.py[cod]
.venv/
venv/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary Files & Scratch
*.tmp
*.temp
scratch/
backend/scratch/
backend/storage/temp/
