# ==============================================================================
# BUYBOX E-COMMERCE — FRONTEND LOCAL & STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Execution Lifecycle:
# - Variables prefixed with NEXT_PUBLIC_ are baked into client JS at BUILD TIME.
# - Variables without NEXT_PUBLIC_ are accessible ONLY on Next.js Node.js SERVER RUNTIME.
# ==============================================================================

# 1. API & BACKEND ROUTING CONFIGURATION
# INTERNAL_API_URL: Direct server-to-server container address (e.g., http://backend:5000)
# Evaluated at server runtime for SSR metadata and Next.js /api rewrite proxying.
INTERNAL_API_URL=http://localhost:5000

# NEXT_PUBLIC_BACKEND_URL: Public backend host origin (build-time client fallback)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# NEXT_PUBLIC_API_URL: Canonical client API endpoint
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# NEXT_PUBLIC_APP_URL: Public frontend storefront URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. PERSISTENT MEDIA DELIVERY & CDN (Optional for local dev)
# NEXT_PUBLIC_CDN_URL: Base URL for media assets (e.g., https://cdn.buybox.com)
NEXT_PUBLIC_CDN_URL=

# ALLOWED_IMAGE_HOSTS: Additional approved external image domains for next/image
ALLOWED_IMAGE_HOSTS=

# 3. PUBLIC CLIENT-SIDE IDENTIFIERS & GATEWAYS
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
