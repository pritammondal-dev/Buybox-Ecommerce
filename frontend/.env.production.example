# ==============================================================================
# BUYBOX E-COMMERCE — PRODUCTION FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# EXECUTION LIFECYCLE & SECURITY RULES:
# 1. Variables prefixed with NEXT_PUBLIC_ are inlined into client JavaScript at
#    BUILD TIME (next build). If these change, the frontend must be re-compiled.
# 2. Variables WITHOUT NEXT_PUBLIC_ (e.g., INTERNAL_API_URL, ALLOWED_IMAGE_HOSTS)
#    are evaluated on the Node.js Next.js SERVER RUNTIME and can be updated
#    dynamically across container restarts without re-compilation.
# 3. NEVER place private credentials, secrets, or internal database URIs here.
# ==============================================================================

# 1. SERVER-SIDE DIRECT API ROUTING (Server Runtime Only)
# When Next.js runs in Docker, Kubernetes, or an internal AWS ECS/VPC network,
# set INTERNAL_API_URL to the direct internal service endpoint to avoid
# hairpin routing through public load balancers.
INTERNAL_API_URL=http://backend:5000

# 2. CLIENT-SIDE PUBLIC API & APPLICATION ENDPOINTS (Build-Time Client Inlining)
# Public origin of the backend API server.
NEXT_PUBLIC_BACKEND_URL=https://api.buybox.com

# Canonical full API base URL for browser clients.
NEXT_PUBLIC_API_URL=https://api.buybox.com/api/v1

# Public storefront URL.
NEXT_PUBLIC_APP_URL=https://buybox.com

# 3. PERSISTENT MEDIA DELIVERY & CDN (Optional / Recommended for Production)
# If using Cloudflare CDN, AWS CloudFront, or direct S3/R2 public distribution,
# provide the public asset URL base (without trailing slash).
NEXT_PUBLIC_CDN_URL=https://cdn.buybox.com

# 4. REMOTE IMAGE OPTIMIZATION ALLOWLIST (Server Runtime & Build Time)
# Comma-separated list of additional external image domains allowed by next/image.
ALLOWED_IMAGE_HOSTS=cdn.buybox.com,buybox-production-media.s3.ap-south-1.amazonaws.com

# 5. PAYMENT GATEWAY CLIENT-SIDE KEY
# Only the public key identifier is permitted here. Key Secret MUST remain backend server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_PRODUCTION_KEY_ID

# 6. GOOGLE OAUTH 2.0 / IDENTITY SERVICES (GIS) CLIENT ID
# Web application client ID configured in Google Cloud Console
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com

